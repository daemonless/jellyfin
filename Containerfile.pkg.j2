{%- set va_deps = "libva mesa-dri" -%}
{%- set va_deps_amd64 = "libva-intel-media-driver gmmlib" -%}
# jellyfin-ffmpeg7 pkg exists only in the latest branch
ARG BASE_VERSION=15.1-latest

FROM ghcr.io/daemonless/base-exec:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG PKG_NAME=jellyfin
ARG PACKAGES="${PKG_NAME} jellyfin-ffmpeg7 ffmpeg {{ va_deps }}"
ARG PACKAGES_AMD64="{{ va_deps_amd64 }}"
ARG UPSTREAM_URL="https://api.github.com/repos/jellyfin/jellyfin/releases/latest"
ARG UPSTREAM_JQ=".tag_name"
{%- if ports %}
ARG HEALTHCHECK_ENDPOINT="http://localhost:{{ ports[0].port }}/health"
{%- else %}
ARG HEALTHCHECK_ENDPOINT="http://localhost:8096/health"
{%- endif %}

ENV HEALTHCHECK_URL="${HEALTHCHECK_ENDPOINT}"

# --- Metadata (Injected by Generator) ---
LABEL org.opencontainers.image.title="{{ title }}" \
      org.opencontainers.image.description="{{ description }}" \
      org.opencontainers.image.source="{{ repo_url }}" \
      org.opencontainers.image.url="{{ web_url }}" \
      org.opencontainers.image.licenses="GPL-2.0-only" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="{{ category }}" \
{%- if ports %}
      io.daemonless.port="{{ ports[0].port }}" \
{%- endif %}
{%- if volumes %}
      io.daemonless.volumes="{{ volumes | map(attribute='path') | join(',') }}" \
{%- endif %}
{%- if mlock %}
      org.freebsd.jail.allow.mlock="required" \
{%- endif %}
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.pkg-source="pkg" \
      io.daemonless.upstream-url="${UPSTREAM_URL}" \
      io.daemonless.upstream-jq="${UPSTREAM_JQ}" \
      io.daemonless.healthcheck-url="${HEALTHCHECK_ENDPOINT}" \
      io.daemonless.pkg-name="${PKG_NAME}" \
      io.daemonless.packages="${PACKAGES}"

# Install from FreeBSD packages
# libva-intel-media-driver is ONLY_FOR_ARCHS= amd64 i386; gmmlib is its dep.
RUN if [ "${FREEBSD_ARCH}" = "amd64" ]; then VA_EXTRA="${PACKAGES_AMD64}"; else VA_EXTRA=""; fi && \
    pkg update && \
    pkg install -y ${PACKAGES} ${VA_EXTRA} && \
    mkdir -p /app /config /cache /media && \
    pkg info ${PKG_NAME} | sed -n 's/.*Version.*: *//p' > /app/version && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/* && \
    find /usr/local -name '*.a' -delete && \
    rm -rf /usr/local/share/doc /usr/local/share/man /usr/local/include /usr/local/llvm19/include /usr/local/llvm19/bin && \
    rm -rf /usr/local/libexec/gcc14 /usr/local/bin/*-portbld-freebsd* /usr/local/*-portbld-freebsd* && \
    rm -f /usr/local/bin/gcc* /usr/local/bin/g++* /usr/local/bin/gfortran* /usr/local/bin/cpp* /usr/local/bin/c++* && \
    rm -f /usr/local/lib/libopcodes* /usr/local/lib/libbfd* && \
    chown bsd:bsd /config /cache /media

# Copy service definition and init scripts
COPY root/ /
RUN chmod +x /daemonless/libexec/jellyfin /daemonless/init.d/*

CMD ["/daemonless/libexec/jellyfin"]

# --- Expose (Injected by Generator) ---
{%- if ports %}
EXPOSE {{ ports | map(attribute='port') | join(' ') }}
{%- endif %}

# --- Volumes (Injected by Generator) ---
{%- if volumes %}
VOLUME {{ volumes | map(attribute='path') | join(' ') }}
{%- endif %}
